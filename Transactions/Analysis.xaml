<Page x:Class="Transactions.Analysis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:DataContext="{d:DesignInstance Type=local:AnalysisMainViewModel}"
      xmlns:local="clr-namespace:Transactions"
       mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Анализ" Height="1000" Width="1500">
    <Grid Background="#c7c9c8">
        <Border MinWidth="450" Margin="20" Background="#e8e9ed" MinHeight="900" MaxHeight="900"
            VerticalAlignment="Center" Padding="50"
            MaxWidth="1500" CornerRadius="30">
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="DarkGray" ShadowDepth="3"/>
        </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Заголовок -->
                    <RowDefinition Height="*"/>
                    <!-- Контент со скроллом -->
                    <RowDefinition Height="Auto"/>
                    <!-- Кнопка -->
                </Grid.RowDefinitions>

                <TextBlock Text="Анализ сделок" FontSize="20" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding CurrentView}" />
                </ScrollViewer>

                <Button Grid.Row="2" HorizontalAlignment="Right" Width="120" Height="45" Margin="0, 10, 0, 0" Content="Главный экран" Click="Button_Back_Click" />
            </Grid>
        </Border>
</Grid>
</Page>
