<UserControl x:Class="Transactions.AddBalance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Transactions" xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" d:DataContext="{d:DesignInstance Type=local:LoadDataViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="1000">
    <Grid Background="#e8e9ed" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <!-- Слева — ввод -->
            <ColumnDefinition Width="340"/>
            <!-- Центр — таблица -->
            <ColumnDefinition Width="*"/>
            <!-- Справа — пусто -->
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Заполните поля ниже и нажмите на кнопку Добавить"
               FontSize="14"
               Grid.Row="0" Grid.Column="0"
               Grid.ColumnSpan="3"
               HorizontalAlignment="Left"/>

        <!-- Поля для ввода -->
        <StackPanel Grid.Row="1" Grid.Column="0"
                Margin="0, 0, 10, 10" VerticalAlignment="Top">
            <ComboBox ItemsSource="{Binding UserAccountsList}"  Name="comboBoxAccount" DisplayMemberPath="DisplayName"
                  Style="{StaticResource WatermarkedComboBoxStyle}" SelectedValuePath="ID" GotFocus="ComboBoxUserAccount_GotFocus"
                   SelectedValue="{Binding SelectedAccountID, Mode=TwoWay}" SelectionChanged="СomboBoxAccount_SelectionChanged"
                  HorizontalAlignment="Left"
                  Width="220" Height="35" Margin="0,10"
                  Tag="Выберете счет">
            </ComboBox>
            <TextBlock x:Name="errorMessageUserAccount" Foreground="#db1d0f" Visibility="Collapsed">
                    Выберете один из вариантов
            </TextBlock>
            
            <TextBox Name="textBoxBalance" Width="220" Margin="0,10" HorizontalAlignment="Left" Tag="Укажите баланс счета" GotFocus="TextBoxBalance_GotFocus"/>
            <TextBlock x:Name="errorMessageBalance1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageBalance2" Foreground="#db1d0f" Visibility="Collapsed">
                    Баланс счета не может меньше 0
            </TextBlock>

            <DatePicker SelectedDate="{Binding SelectedDate}" Height="35" Width="220" Margin="0,10" HorizontalAlignment="Left" GotFocus="DatePicker_GotFocus" Tag="Выберете дату"
            SelectedDateFormat="Short"  Name="DatePicker"/>
            <TextBlock x:Name="errorMessageDate" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="BalancesDataGrid" Grid.Row="1" Grid.Column="1" Height="230"
              ItemsSource="{Binding Balances}"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              Margin="0, 10, 0, 0"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding accountID}" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Счет" Binding="{Binding account}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding date}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Баланс" Binding="{Binding balance}" Width="100" IsReadOnly="False"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Grid.Column="2">
            <lvc:CartesianChart Name="CartesianChart" Series="{Binding SeriesCollection}" Height="251" />
        </StackPanel>

        <!-- Кнопка Добавить -->
        <Button Grid.Row="2" Grid.Column="0"
            Width="100" Height="45" Margin="0, 10, 10, 10"
            Content="Добавить"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Click="Button_Add_Click"/>

        <!-- Кнопки Изменить/Удалить -->
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Width="100" Height="45" Margin="0, 10, 0, 10"
            Content="Изменить" Click="Button_Update_Click" HorizontalAlignment="Left"/>
            <Button Grid.Column="1" Width="100" Height="45" Margin="0, 10, 0, 10"
            Content="Удалить" Click="Button_Delete_Click" HorizontalAlignment="Right"/>
        </Grid>
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="160" Height="45" Margin="10, 10, 0, 10" Content="Добавить новый счет" Command="{Binding ShowAddUserAccount}"/>
        </StackPanel>
    </Grid>
</UserControl>
