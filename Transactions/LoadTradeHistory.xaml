<UserControl x:Class="Transactions.LoadTradeHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Transactions" d:DataContext="{d:DesignInstance Type=local:LoadDataViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="800">
    <Grid Background="#e8e9ed" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Поля для ввода -->
            <RowDefinition Height="180"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка -->
        </Grid.RowDefinitions>

        <TextBlock Text="Заполните поля ниже и нажмите на кнопку Добавить" FontSize="14" Grid.Row="0" HorizontalAlignment="Left"/>

        <!-- Поля для ввода (6 полей) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                ItemsSource="{Binding UserAccountsList}" Name="comboBoxAccount" DisplayMemberPath="DisplayName" GotFocus="СomboBoxAccount_GotFocus"
                Style="{StaticResource WatermarkedComboBoxStyle}" SelectedValuePath="ID" SelectedValue="{Binding SelectedAccountID, Mode=TwoWay}"
                HorizontalAlignment="Left" Width="220" Height="35" Margin="0,10" Tag="Выберете счет">
                </ComboBox>
            <TextBlock x:Name="errorMessageAccount" VerticalAlignment="Bottom" Foreground="#db1d0f" Visibility="Collapsed">
                    Выберете один из вариантов
                </TextBlock>

                <Button Grid.Column="1" Width="200" Height="45" Margin="0, 10, 0, 10" Content="Очистить историю сделок" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Button_DeleteTradeHistory_Click"/>
            </Grid>

            <!-- Таблица -->
        <DataGrid x:Name="TradesDataGrid" Grid.Row="2" HorizontalScrollBarVisibility="Auto"
          ItemsSource="{Binding Trades}"
          AutoGenerateColumns="False"
          IsReadOnly="False"
          Margin="10, 10, 0, 10"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn  Binding="{Binding userAccountID}" Width="*" Visibility="Collapsed" IsReadOnly="True"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding number}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Счет" Binding="{Binding account}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Инструмент" Binding="{Binding ticker}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding date}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Направление" Binding="{Binding direction}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Цена открытия" Binding="{Binding openingPrice}" Width="100" IsReadOnly="False"/>
                <DataGridTextColumn Header="Цена закрытия" Binding="{Binding closingPrice}" Width="100" IsReadOnly="False"/>
                <DataGridTextColumn Header="Кол-во лотов" Binding="{Binding lots}" Width="*" IsReadOnly="False"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding result}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ком-сия брокера" Binding="{Binding brokerCommission}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ком-сия биржи" Binding="{Binding exchangeCommission}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Итог" Binding="{Binding total}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка -->
        <Button Grid.Row="3"  Grid.ColumnSpan="2"
        Width="120" Height="45" Margin="0, 10, 0, 10"
        Content="Загрузить"
        HorizontalAlignment="Right" VerticalAlignment="Top"
        Click="Button_LoadTradeHistory_Click"/>
    </Grid>

</UserControl>
