<UserControl x:Class="Transactions.AddBrokerageAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Transactions" d:DataContext="{d:DesignInstance Type=local:LoadDataViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="800">
    <Grid Background="#e8e9ed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Поля для ввода и таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Левая часть: поля для ввода -->
            <ColumnDefinition Width="6*"/>
            <!-- Правая часть: таблица (будет занимать 6 частей из 8) -->
        </Grid.ColumnDefinitions>

        <TextBlock Text="Заполните поля ниже и нажмите на кнопку Добавить" FontSize="14" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>

        <!-- Поля для ввода (6 полей) -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0, 10, 0, 0" VerticalAlignment="Top">
            <TextBox Name="textBoxBrokerName" Width="280" Margin="0,10" HorizontalAlignment="Left" Tag="Введите название брокера" GotFocus="TextBoxBrokerName_GotFocus"/>
            <TextBlock x:Name="errorMessageBrokerName" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            
            <TextBox Name="textBoxAccountName" Width="280" Margin="0,10" HorizontalAlignment="Left" Tag="Введите название тарифа" GotFocus="TextBoxAccountName_GotFocus"/>
            <TextBlock x:Name="errorMessageAccountName" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            
            <TextBox Name="textBoxStockMinCommission" Width="280" Margin="0,10" HorizontalAlignment="Left" Tag="Укажите мин. комиссию для акций" GotFocus="TextBoxStockMinCommission_GotFocus"/>
            <TextBlock x:Name="errorMessageStockMinCommission1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageStockMinCommission2" Foreground="#db1d0f" Visibility="Collapsed">
                    Минимальная комиссия должна быть не меньше 0
            </TextBlock>

            <TextBox Name="textBoxStockDefaultCommission" Width="280" Margin="0,10" HorizontalAlignment="Left" Tag="Укажите станд. комиссию для акций" GotFocus="TextBoxStockDefaultCommission_GotFocus"/>
            <TextBlock x:Name="errorMessageStockDefaultCommission1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageStockDefaultCommission2" Foreground="#db1d0f" Visibility="Collapsed">
                    Стандартная коммиссия должна быть не меньше 0
            </TextBlock>

            <TextBox Name="textBoxFuturesMinCommission" Width="280" Margin="0,10" HorizontalAlignment="Left" Tag="Укажите мин. комиссию для фьючерсов" GotFocus="TextBoxFuturesMinCommission_GotFocus"/>
            <TextBlock x:Name="errorMessageFuturesMinCommission1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageFuturesMinCommission2" Foreground="#db1d0f" Visibility="Collapsed">
                    Минимальная комиссия должна быть не меньше 0
            </TextBlock>

            <TextBox Name="textBoxFuturesDefaultCommission" Width="280" Margin="0,10" HorizontalAlignment="Left" Tag="Укажите станд. комиссию для фьючерсов" GotFocus="TextBoxFuturesDefaultCommission_GotFocus"/>
            <TextBlock x:Name="errorMessageFuturesDefaultCommission1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageFuturesDefaultCommission2" Foreground="#db1d0f" Visibility="Collapsed">
                    Стандартная комиссия должна быть не меньше 0
            </TextBlock>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="BrokerageAccountsDataGrid" Grid.Row="1" Grid.Column="1"
          ItemsSource="{Binding BrokerageAccounts}"
          AutoGenerateColumns="False"
          IsReadOnly="False"
          Margin="10, 10, 0, 10"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding brokerageAccountID}" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Название брокера" Binding="{Binding brokerName}" Width="115"/>
                <DataGridTextColumn Header="Название (или номер) счета" Binding="{Binding accountName}" Width="170"/>
                <DataGridTextColumn Header="Мин. коммиссия для акций" Binding="{Binding stockMinCommission}" Width="160"/>
                <DataGridTextColumn Header="Станд. коммиссия для акций" Binding="{Binding stockDefaultCommission}" Width="170"/>
                <DataGridTextColumn Header="Мин. коммиссия для фьючерсов" Binding="{Binding futuresMinCommission}" Width="193"/>
                <DataGridTextColumn Header="Станд. коммиссия для фьючерсов" Binding="{Binding futuresDefaultCommission}" Width="197"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
        Width="100" Height="45" Margin="0, 10, 10, 10"
        Content="Добавить"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Click="Button_Add_Click"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Height="45" Margin="10, 10, 0, 10" Content="Изменить" Click="Button_Update_Click"/>
            <Button Width="100" Height="45" Margin="10, 10, 0, 10" Content="Удалить" Click="Button_Delete_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
