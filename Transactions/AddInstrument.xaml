<UserControl x:Class="Transactions.AddInstrument"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Transactions" d:DataContext="{d:DesignInstance Type=local:LoadDataViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="800">
    <Grid Background="#e8e9ed" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Поля для ввода и таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Левая часть: поля для ввода -->
            <ColumnDefinition Width="6*"/>
            <!-- Правая часть: таблица (будет занимать 6 частей из 8) -->
        </Grid.ColumnDefinitions>

        <TextBlock Text="Заполните поля ниже и нажмите на кнопку Добавить" FontSize="14" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>

        <!-- Поля для ввода (6 полей) -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0, 10, 10, 10" VerticalAlignment="Top">
            <TextBox Name="textBoxTicker" Width="220" Margin="0,10" HorizontalAlignment="Left" Tag="Введите тикер инструмента" GotFocus="TextBoxTicker_GotFocus"/>
            <TextBlock x:Name="errorMessageTicker1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageTicker2" Foreground="#db1d0f" Visibility="Collapsed">
                    Инструмент с таким тикером уже существует
            </TextBlock>
            
            <TextBox Name="textBoxName" Width="220" Margin="0,10" HorizontalAlignment="Left" Tag="Введите название(описание)" GotFocus="TextBoxName_GotFocus"/>
            <TextBlock x:Name="errorMessageName" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            
            <ComboBox Name="comboBoxType" Style="{StaticResource WatermarkedComboBoxStyle}"  HorizontalAlignment="Left" Tag="Выберете тип инструмента"
                  Width="220" Height="35" Margin="0,10"  GotFocus="ComboBoxType_GotFocus">
                <ComboBoxItem Content="Акция"/>
                <ComboBoxItem Content="Фьючерс"/>
            </ComboBox>
            <TextBlock x:Name="errorMessageType" Foreground="#db1d0f" Visibility="Collapsed">
                    Выберете один из вариантов
            </TextBlock>
            
            <TextBox Name="textBoxStep" Width="220" Margin="0,10" HorizontalAlignment="Left" Tag="Укажите шаг цены" GotFocus="TextBoxStep_GotFocus"/>
            <TextBlock x:Name="errorMessageStep1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageStep2" Foreground="#db1d0f" Visibility="Collapsed">
                    Шаг цены должен быть больше 0
            </TextBlock>
            
            <TextBox Name="textBoxStepCost" Width="220" Margin="0,10" HorizontalAlignment="Left" Tag="Укажите стоимость шага цены" GotFocus="TextBoxStepCost_GotFocus"/>
            <TextBlock x:Name="errorMessageStepCost1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageStepCost2" Foreground="#db1d0f" Visibility="Collapsed">
                    Стоимость шага цены должна быть больше 0
            </TextBlock>
            
            <TextBox Name="textBoxLotsize" Width="220" Margin="0,10" HorizontalAlignment="Left" Tag="Укажите лотность инструмента" GotFocus="TextBoxLotsize_GotFocus"/>
            <TextBlock x:Name="errorMessageLotsize1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageLotsize2" Foreground="#db1d0f" Visibility="Collapsed">
                    Размер лота не может быть меньше 1
            </TextBlock>
            <TextBlock x:Name="errorMessageLotsize3" Foreground="#db1d0f" Visibility="Collapsed">
                    Размер лота может быть только целым числом
            </TextBlock>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="InstrumentsDataGrid" Grid.Row="1" Grid.Column="1"
          ItemsSource="{Binding Instruments}"
          AutoGenerateColumns="False"
          IsReadOnly="False"
          Margin="10, 10, 0, 10"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тикер" Binding="{Binding ticker}" Width="60"/>
                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding type}" Width="70"/>
                <DataGridTextColumn Header="Шаг цены" Binding="{Binding priceStep}" Width="80"/>
                <DataGridTextColumn Header="Стоимость шага цены" Binding="{Binding priceStepCost}" Width="140"/>
                <DataGridTextColumn Header="Лотность" Binding="{Binding lotsize}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
        Width="100" Height="45" Margin="0, 10, 10, 10"
        Content="Добавить"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Click="Button_Add_Click"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Height="45" Margin="10, 10, 0, 10" Content="Изменить" Click="Button_Update_Click"/>
            <Button Width="100" Height="45" Margin="10, 10, 0, 10" Content="Удалить" Click="Button_Delete_Click"/>
        </StackPanel>
    </Grid>

</UserControl>
