<Window x:Class="Transactions.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Transactions"
         mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Регистрация" Height="650" Width="1200">
    <Grid Background="#c7c9c8">
        <Border MinWidth="450" Margin="20" Background="#e8e9ed" VerticalAlignment="Center" Padding="50" MaxWidth="1000" CornerRadius="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="DarkGray" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Регистрация" FontSize="20" FontWeight="Bold" Margin="0 0 0 20"/>
                <TextBox x:Name="textBoxName" materialDesign:HintAssist.Hint="Введите ваше имя" Style="{StaticResource CustomFloatingHintTextBox}" GotFocus="TextBoxName_GotFocus"/>
                <TextBlock x:Name="ErrorMessageName" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле
                </TextBlock>
                <TextBox x:Name="textBoxLogin" materialDesign:HintAssist.Hint="Придумайте логин" Style="{StaticResource CustomFloatingHintTextBox}" GotFocus="TextBoxLogin_GotFocus" />
                <TextBlock x:Name="ErrorMessageLogin" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле
                </TextBlock>
                <TextBlock x:Name="ErrorMessageLogin2" Foreground="#db1d0f" Visibility="Collapsed">
                    Пользователь с таким логином уже существует. Придумайте другой логин
                </TextBlock>
                <PasswordBox x:Name="passwordBoxPass1" materialDesign:HintAssist.Hint="Придумайте пароль" Style="{StaticResource CustomFloatingHintPasswordBox}" GotFocus="PassBox1_GotFocus" />
                <TextBlock x:Name="ErrorMessagePass1" Foreground="#db1d0f" Visibility="Collapsed">
                    Пароль должен состоять минимум из 4 символов
                </TextBlock>
                <PasswordBox x:Name="passwordBoxPass2" materialDesign:HintAssist.Hint="Повторите пароль" Style="{StaticResource CustomFloatingHintPasswordBox}" GotFocus="PassBox2_GotFocus" />
                <TextBlock x:Name="ErrorMessagePass2" Foreground="#db1d0f" Visibility="Collapsed">
                    Пароли не совпадают
                </TextBlock>
                <Grid Margin="0 20 0 10">
                    <Button HorizontalAlignment="Left" Width="180" Height="45" Content="Зарегистрироваться" Click="Button_Reg_Click"/>
                    <Button HorizontalAlignment="Right" Width="100" Height="45" Content="Назад" Click="Button_Back_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
