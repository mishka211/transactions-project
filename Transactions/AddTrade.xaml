<UserControl x:Class="Transactions.AddTrade"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Transactions" d:DataContext="{d:DesignInstance Type=local:LoadDataViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">
    <Grid Background="#e8e9ed" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="450"/>
            <!-- Поля для ввода и таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Левая часть: поля для ввода -->
            <ColumnDefinition Width="6*"/>
            <!-- Правая часть: таблица (будет занимать 6 частей из 8) -->
        </Grid.ColumnDefinitions>

        <TextBlock Text="Заполните поля ниже и нажмите на кнопку Добавить" FontSize="14" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>

        <!-- Поля для ввода (6 полей) -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0, 10, 10, 10" VerticalAlignment="Top">

            <ComboBox ItemsSource="{Binding Instruments}" Name="comboBoxInstrument" DisplayMemberPath="DisplayName"
                  Style="{StaticResource WatermarkedComboBoxStyle}" SelectedValuePath="ID"
                  SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}"
                  HorizontalAlignment="Left"
                  Width="230" Height="35" Margin="0,10" GotFocus="СomboBoxInstrument_GotFocus"
                  Tag="Выберете инструмент">
            </ComboBox>
            <TextBlock x:Name="errorMessageInstrument" Foreground="#db1d0f" Visibility="Collapsed">
                    Выберете один из вариантов
            </TextBlock>

            <ComboBox 
                ItemsSource="{Binding UserAccountsList}" Name="comboBoxAccount" DisplayMemberPath="DisplayName" GotFocus="СomboBoxAccount_GotFocus"
                Style="{StaticResource WatermarkedComboBoxStyle}" SelectedValuePath="ID" SelectedValue="{Binding SelectedAccountID, Mode=TwoWay}"
                SelectionChanged="СomboBoxAccount_SelectionChanged"
                HorizontalAlignment="Left" Width="230" Height="35" Margin="0,10" Tag="Выберете счет">
            </ComboBox>
            <TextBlock x:Name="errorMessageAccount" Foreground="#db1d0f" Visibility="Collapsed">
                    Выберете один из вариантов
            </TextBlock>

            <DatePicker SelectedDate="{Binding SelectedDate}" Height="35" Width="230" Margin="0,10" HorizontalAlignment="Left" GotFocus="DatePicker_GotFocus" Tag="Выберете дату"
            SelectedDateFormat="Short"  Name="DatePicker"/>
            <TextBlock x:Name="errorMessageDate" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>

            <ComboBox Name="comboBoxDirection" Style="{StaticResource WatermarkedComboBoxStyle}"  HorizontalAlignment="Left" Tag="Выберете направление сделки"
                  Width="230" Height="35" Margin="0,10" GotFocus="СomboBoxDirection_GotFocus">
                <ComboBoxItem Content="Лонг"/>
                <ComboBoxItem Content="Шорт"/>
            </ComboBox>
            <TextBlock x:Name="errorMessageDirection" Foreground="#db1d0f" Visibility="Collapsed">
                    Выберете один из вариантов
            </TextBlock>

            <TextBox Name="textBoxOpeningPrice" Width="230" Margin="0,10" HorizontalAlignment="Left" Tag="Введите цену открытия сделки" GotFocus="TextBoxOpeningPrice_GotFocus"/>
            <TextBlock x:Name="errorMessageOpeningPrice1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageOpeningPrice2" Foreground="#db1d0f" Visibility="Collapsed">
                    Цена открытия сделки не может быть меньше 0
            </TextBlock>

            <TextBox Name="textBoxClosingPrice" Width="230" Margin="0,10" HorizontalAlignment="Left" Tag="Введите цену закрытия сделки" GotFocus="TextBoxClosingPrice_GotFocus"/>
            <TextBlock x:Name="errorMessageClosingPrice1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageClosingPrice2" Foreground="#db1d0f" Visibility="Collapsed">
                    Цена закрытия сделки не может быть меньше 0
            </TextBlock>

            <TextBox Name="textBoxLots" Width="230" Margin="0,10" HorizontalAlignment="Left" Tag="Введите количество лотов" GotFocus="TextBoxLots_GotFocus"/>
            <TextBlock x:Name="errorMessageLots1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageLots2" Foreground="#db1d0f" Visibility="Collapsed">
                    Количество лотов не может быть меньше 1
            </TextBlock>
            <TextBlock x:Name="errorMessageLots3" Foreground="#db1d0f" Visibility="Collapsed">
                    Количество лотов может быть только целым
            </TextBlock>

        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="TradesDataGrid" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
          ItemsSource="{Binding Trades}"
          AutoGenerateColumns="False"
          IsReadOnly="False"
          Margin="10, 10, 0, 10"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn  Binding="{Binding userAccountID}" Width="SizeToHeader" Visibility="Collapsed" IsReadOnly="True"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding number}" Width="SizeToHeader" IsReadOnly="True"/>
                <DataGridTextColumn Header="Счет" Binding="{Binding account}" Width="SizeToHeader" IsReadOnly="True"/>
                <DataGridTextColumn Header="Инструмент" Binding="{Binding ticker}" Width="SizeToHeader" IsReadOnly="True"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding date}" Width="SizeToHeader" IsReadOnly="True"/>
                <DataGridTextColumn Header="Направление" Binding="{Binding direction}" Width="SizeToHeader" IsReadOnly="True"/>
                <DataGridTextColumn Header="Цена открытия" Binding="{Binding openingPrice}" Width="SizeToHeader" IsReadOnly="False"/>
                <DataGridTextColumn Header="Цена закрытия" Binding="{Binding closingPrice}" Width="SizeToHeader" IsReadOnly="False"/>
                <DataGridTextColumn Header="Кол-во лотов" Binding="{Binding lots}" Width="SizeToHeader" IsReadOnly="False"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding result}" Width="SizeToHeader" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ком-сия брокера" Binding="{Binding brokerCommission}" Width="SizeToHeader" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ком-сия биржи" Binding="{Binding exchangeCommission}" Width="SizeToHeader" IsReadOnly="True"/>
                <DataGridTextColumn Header="Итог" Binding="{Binding total}" Width="SizeToHeader" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
        Width="100" Height="45" Margin="0, 10, 10, 10"
        Content="Добавить"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Click="Button_Add_Click"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Height="45" Margin="10, 10, 0, 10" Content="Изменить" Click="Button_Update_Click"/>
            <Button Width="100" Height="45" Margin="10, 10, 0, 10" Content="Удалить" Click="Button_Delete_Click"/>
        </StackPanel>
    </Grid>

</UserControl>
