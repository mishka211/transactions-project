<UserControl x:Class="Transactions.AddUserAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Transactions" d:DataContext="{d:DesignInstance Type=local:LoadDataViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="800">
    <Grid Background="#e8e9ed" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Поля для ввода и таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Левая часть: поля для ввода -->
            <ColumnDefinition Width="6*"/>
            <!-- Правая часть: таблица (будет занимать 6 частей из 8) -->
        </Grid.ColumnDefinitions>

        <TextBlock Text="Заполните поля ниже и нажмите на кнопку Добавить" FontSize="14" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0, 10, 10, 10" VerticalAlignment="Top">
            <TextBox Name="textBoxAccountNumber" Width="240" Margin="0,10" HorizontalAlignment="Left" Tag="Введите название или номер счета"  GotFocus="textBoxAccountNumber_GotFocus"/>
            <TextBlock x:Name="errorMessageAccountNumber1" Foreground="#db1d0f" Visibility="Collapsed">
                    Заполните это поле корректно
            </TextBlock>
            <TextBlock x:Name="errorMessageAccountNumber2" Foreground="#db1d0f" Visibility="Collapsed">
                    Это название или номер счета уже занят. Придумайте уникальное
            </TextBlock>

            <ComboBox ItemsSource="{Binding BrokerageAccounts}" Name="comboBoxBrokerAccount" DisplayMemberPath="DisplayName"
                  Style="{StaticResource WatermarkedComboBoxStyle}" SelectedValuePath="ID" GotFocus="ComboBoxBrokerAccount_GotFocus"
                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                  HorizontalAlignment="Left"
                  Width="240" Height="35" Margin="0,10"
                  Tag="Выберете брокерский счет">
            </ComboBox>
            <TextBlock x:Name="errorMessageBrokerageAccount" Foreground="#db1d0f" Visibility="Collapsed">
                    Выберете один из вариантов
            </TextBlock>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="UserAccountsDataGrid" Grid.Row="1" Grid.Column="1"
          ItemsSource="{Binding UserAccountsShowing}"
          AutoGenerateColumns="False"
          IsReadOnly="False"
          Margin="10, 10, 0, 10"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding accountID}" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Название или номер счета" Binding="{Binding accountNumber}" Width="160" IsReadOnly="False"/>
                <DataGridTextColumn Header="Брокер" Binding="{Binding brokerName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Тариф" Binding="{Binding accountName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Текущий баланс" Binding="{Binding balance}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
        Width="100" Height="45" Margin="0, 10, 10, 10"
        Content="Добавить"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Click="Button_Add_Click"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Height="45" Margin="10, 10, 0, 10" Content="Изменить" Click="Button_Update_Click"/>
            <Button Width="100" Height="45" Margin="10, 10, 0, 10" Content="Удалить" Click="Button_Delete_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
