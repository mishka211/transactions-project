<UserControl x:Class="Transactions.ResultStats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:DataContext="{d:DesignInstance Type=local:AnalysisMainViewModel}"
             xmlns:local="clr-namespace:Transactions" xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <Grid Background="#e8e9ed">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <DataGrid Height="293" x:Name="TradesDataGrid" HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding Trades}" AutoGenerateColumns="False"
                             IsReadOnly="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <DataGrid.Columns>
                    <DataGridTextColumn  Binding="{Binding userAccountID}" Width="*" Visibility="Collapsed" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Номер" Binding="{Binding number}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Счет" Binding="{Binding account}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Инструмент" Binding="{Binding ticker}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding date}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Направление" Binding="{Binding direction}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Цена открытия" Binding="{Binding openingPrice}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Цена закрытия" Binding="{Binding closingPrice}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Кол-во лотов" Binding="{Binding lots}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Результат" Binding="{Binding result}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ком-сия брокера" Binding="{Binding brokerCommission}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ком-сия биржи" Binding="{Binding exchangeCommission}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Итог" Binding="{Binding total}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button  HorizontalAlignment="Right" Width="150" Height="45" Content="Разбить по дням" Click="Button_SplitByDays_Click" />
            <Button  HorizontalAlignment="Right" Width="150" Height="45" Content="Разбить по неделям" Click="Button_SplitByWeeks_Click" />
            <Button  HorizontalAlignment="Right" Width="150" Height="45" Content="Разбить по месяцам" Click="Button_SplitByMonths_Click" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <lvc:CartesianChart Name="CartesianChart" Series="{Binding SeriesCollection}" Height="290"/>
        </StackPanel>
        
        <Button Grid.Row="3" HorizontalAlignment="Right" Width="100" Height="45" Content="Назад" Command="{Binding BackToMainCommand}"/>
    </Grid>
</UserControl>
